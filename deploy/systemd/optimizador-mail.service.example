[Unit]
Description=Optimizador email API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/optimizador/current
EnvironmentFile=/etc/optimizador.env
ExecStart=/usr/bin/node api/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/optimizador/material-images

[Install]
WantedBy=multi-user.target